# ESP32-P4 (JC-ESP32P4-M3-DEV) — BLE через бортовой C6 по SDIO
CONFIG_IDF_TARGET="esp32p4"

# Плата на ECO2 (chip rev v1.3): rev <3.0 несовместим с >=3.0
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_FULL=100
CONFIG_ESP_REV_MIN_FULL=100
# ECO2 не держит 400МГц — только 360
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=360
# PSRAM 32МБ hex — 80МГц работает на этой rev1.3 (проверено: банки из PSRAM стабильны)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED=80

# Оптимизация для аудиосинтеза (sinf/флоат-интерполяция на каждый сэмпл)
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# OTA: откат на прошлый слот, если новый образ не дошёл до app_main
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Флеш 16МБ + кастомная таблица (ota_0/ota_1 3МБ + slave_fw 2МБ @0x620000)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# esp_hosted: SDIO-линк P4<->C6 + BT HCI
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_ENABLE_BT_HCI=y
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y

# NimBLE host
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_NVS_PERSIST=n
